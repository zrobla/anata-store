DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Origines autorisees pour les POST cross-origin (CSRF). Requis en prod si le front est sur un domaine distinct.
DJANGO_CSRF_TRUSTED_ORIGINS=

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

CORS_ALLOWED_ORIGINS=http://localhost:3000
